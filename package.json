{
  "name": "mrjz-app",
  "version": "0.1.0",
  "private": true,
  "description": "MRJZ Dota 2 community tournament platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run one target: npm run dev:api | dev:admin | dev:mobile-web | dev:miniprogram\"",
    "dev:api": "npm --workspace @mrjz/api run dev",
    "dev:admin": "npm --workspace @mrjz/admin run dev",
    "dev:mobile-web": "npm --workspace @mrjz/mobile-web run dev",
    "dev:mobile-web:local": "npm --workspace @mrjz/mobile-web run dev:local",
    "dev:mobile-web:remote": "npm --workspace @mrjz/mobile-web run dev:remote",
    "dev:desktop-web": "npm --workspace @mrjz/desktop-web run dev",
    "dev:desktop-web:local": "npm --workspace @mrjz/desktop-web run dev:local",
    "dev:desktop-web:remote": "npm --workspace @mrjz/desktop-web run dev:remote",
    "dev:miniprogram": "npm --workspace @mrjz/miniprogram run dev",
    "dev:miniprogram:local": "npm --workspace @mrjz/miniprogram run dev:local",
    "dev:miniprogram:local-assets": "npm --workspace @mrjz/miniprogram run dev:local-assets",
    "dev:miniprogram:proxy": "npm --workspace @mrjz/miniprogram run dev:proxy",
    "dev:miniprogram:api-proxy": "node scripts/miniprogram-api-proxy.mjs",
    "dev:miniprogram:remote": "npm --workspace @mrjz/miniprogram run dev:remote",
    "db:init": "npm --workspace @mrjz/api run db:init",
    "db:reset": "npm --workspace @mrjz/api run db:reset",
    "db:status": "npm --workspace @mrjz/api run db:status",
    "sync:opendota": "npm --workspace @mrjz/api run sync:opendota",
    "sync:opendota:backfill": "npm --workspace @mrjz/api run sync:opendota:backfill",
    "sync:entities": "npm --workspace @mrjz/api run sync:entities",
    "sync:steam-profiles": "npm --workspace @mrjz/api run sync:steam-profiles",
    "assets:mobile-web": "npm --workspace @mrjz/mobile-web run cache:dota-assets",
    "build": "npm run build --workspaces --if-present",
    "build:mobile-web:local": "npm --workspace @mrjz/mobile-web run build:local",
    "build:mobile-web:remote": "npm --workspace @mrjz/mobile-web run build:remote",
    "build:desktop-web": "npm --workspace @mrjz/desktop-web run build",
    "build:desktop-web:local": "npm --workspace @mrjz/desktop-web run build:local",
    "build:desktop-web:remote": "npm --workspace @mrjz/desktop-web run build:remote",
    "build:miniprogram:local": "npm --workspace @mrjz/miniprogram run build:local",
    "build:miniprogram:local-assets": "npm --workspace @mrjz/miniprogram run build:local-assets",
    "build:miniprogram:proxy": "npm --workspace @mrjz/miniprogram run build:proxy",
    "build:miniprogram:remote": "npm --workspace @mrjz/miniprogram run build:remote",
    "build:miniprogram:h5-local": "npm --workspace @mrjz/miniprogram run build:h5-local",
    "visual:parity": "node scripts/visual-parity.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:docs": "python3 -m html.parser docs/design/page-direction.html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/router": "^4.2.0",
    "@types/node": "^22.0.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "webpack": "5.91.0"
  }
}
