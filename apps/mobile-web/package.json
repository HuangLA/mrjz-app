{
  "name": "@mrjz/mobile-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api vite --host 0.0.0.0 --port 5174",
    "dev:remote": "VITE_USE_REMOTE_API_PROXY=1 VITE_PUBLIC_API_BASE_URL=/api vite --host 0.0.0.0 --port 5174",
    "build": "npm run build:local",
    "build:local": "VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api tsc -p tsconfig.json && VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api vite build",
    "build:remote": "VITE_PUBLIC_API_BASE_URL=/api tsc -p tsconfig.json && VITE_PUBLIC_API_BASE_URL=/api vite build",
    "cache:dota-assets": "node scripts/cache-dota-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"TODO: add mobile web lint\"",
    "test": "tsc -p tsconfig.test.json --noEmit && node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fontsource/zcool-kuaile": "^5.2.8",
    "@mrjz/shared": "0.1.0",
    "animal-island-ui": "1.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
