# API
NODE_ENV=development
API_PORT=3001
MRJZ_DB_PATH=var/mrjz.sqlite
DATABASE_URL=postgres://mrjz:mrjz@127.0.0.1:5432/mrjz
REDIS_URL=redis://127.0.0.1:6379/0

# Auth
JWT_SECRET=replace-me
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MRJZ_DEV_WECHAT_USER_ID=local

# OpenDota
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_DEFAULT_INTERVAL_MINUTES=30

# Steam Web API
STEAM_API_KEY=
STEAM_PROFILE_SYNC_INTERVAL_MS=86400000
STEAM_PROFILE_SYNC_RUN_ON_START=0
MRJZ_DISABLE_STEAM_PROFILE_WORKER=0

# Public URLs
PUBLIC_API_BASE_URL=http://localhost:3001/api
PUBLIC_H5_BASE_URL=http://localhost:5174
